rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Enrichment: flat, global collections keyed by an app-owned canonical key
    // (normalized name + rounded lat/lon — see src/domain/placeEnrichment.ts), NOT by
    // trip or by any provider's proprietary ID. This is what lets the same physical
    // place enriched via different trips (or different providers, e.g. Google now vs.
    // Foursquare/Yelp later) share one cached record instead of duplicating API spend.
    // Any authenticated user can read; only Cloud Functions write. The deployed
    // `enrichPlaces` callable (functions/src/enrichPlaces.ts) writes place_enrichment
    // docs via the Admin SDK after a live Foursquare lookup, and the one-time import in
    // scripts/importFirestoreEnrichment.ts also used Admin SDK credentials for its
    // backfill — both bypass these rules entirely, which is why `allow write: if false`
    // below is safe: no client write path exists or should ever exist.
    match /place_enrichment/{canonicalKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /trail_enrichment/{canonicalKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /hotel_enrichment/{canonicalKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Drive times between two points, keyed by rounded coordinates (see the root app's
    // src/domain/routeCache.ts). Same shape as the enrichment collections above and for
    // the same reason: the client reads it directly so a cache hit costs one Firestore
    // read rather than a Cloud Function invocation plus a paid Mapbox call, while only
    // the `routeBetween` callable — running under the Admin SDK, which bypasses these
    // rules — ever writes.
    //
    // Documents hold ONLY our own derived integers (minutes, miles, cachedAt). No route
    // geometry and no raw provider response is ever stored here.
    match /route_cache/{routeKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // The per-uid and global API spend ledger (functions/src/quota.ts). Unlike every
    // collection above, this one is closed to clients in BOTH directions.
    //
    // Not writable, for the obvious reason: a client that can edit its own ledger has no
    // quota. Not readable either, which is the less obvious half — the same collection
    // holds `g_{date}`, the pooled global counter, so a read grants any signed-in caller
    // a live view of total platform spend and, more usefully to someone probing it,
    // exactly how much headroom remains before the cap bites.
    //
    // The callables reach these docs through the Admin SDK, which bypasses rules
    // entirely, so closing the client path costs the app nothing.
    match /api_quota/{quotaKey} {
      allow read, write: if false;
    }
  }
}
