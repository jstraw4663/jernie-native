{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "RCT_USE_PREBUILT_RNCORE": "0",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "preview",
      "env": {
        "APP_ENV": "preview",
        "RCT_USE_PREBUILT_RNCORE": "0",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "RCT_USE_PREBUILT_RNCORE": "0",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    }
  }
}
