{
  "cli": { "version": ">= 10.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_ENV": "development" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "channel": "preview",
      "env": { "APP_ENV": "preview" }
    },
    "production": {
      "channel": "production",
      "env": { "APP_ENV": "production" }
    }
  }
}
