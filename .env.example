# Copy to .env and fill in values — never commit .env
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# App Check debug token — DEV BUILDS ONLY.
# Any UUID you choose; register the same value in Firebase console → App Check →
# Manage debug tokens. Generate one with: uuidgen
# Leave BLANK in .env.example. A real value belongs only in .env, which is gitignored:
# anyone holding it can mint valid App Check tokens for this Firebase project.
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=
