# Deploy-time values for the params declared in src/appCheck.ts and src/quota.ts.
#
# WHY THIS FILE EXISTS: without it the CLI prompts for all eleven on every deploy, which
# is slow, easy to fat-finger, and makes a deploy non-reproducible. Firebase reads this
# automatically for the matching project id.
#
# NOT A SECRET FILE. Quota ceilings and an enforcement flag are configuration, and are
# meant to be reviewable in the repo. Real credentials go to Secret Manager and are bound
# per-function via `{ secrets: [...] }` — see src/secrets.ts. Never add one here.

# App Check enforcement. Stays false until the shipped app is demonstrably sending valid
# tokens; see the rollout order in src/appCheck.ts. Flipping this is a deploy, not a code
# change.
ENFORCE_APP_CHECK=false

# Per-uid ceilings, per endpoint. These meter BILLED PROVIDER CALLS, not invocations —
# see src/quota.ts for why the charge sits below each cache check.
QUOTA_RESOLVE_QUERY_DAY=300
QUOTA_RESOLVE_QUERY_MINUTE=30

# enrichPlaces charges one unit PER PLACE and its batch cap is 30, so the per-minute
# figure MUST stay above 30 or a single legitimate full batch can never pass.
QUOTA_ENRICH_PLACES_DAY=200
QUOTA_ENRICH_PLACES_MINUTE=60

QUOTA_ROUTE_BETWEEN_DAY=200
QUOTA_ROUTE_BETWEEN_MINUTE=30

# Mapbox is MAU-billed so the marginal call is nearly free; the ceiling is here to catch a
# loop, not to ration.
QUOTA_SEARCH_STOPS_DAY=60
QUOTA_SEARCH_STOPS_MINUTE=15

# The pooled ceiling across every user, and the one that actually caps spend — sign-in is
# anonymous, so a fresh uid is a fresh per-uid quota. ~$50/day at the worst-case blended
# rate. A circuit breaker, not a budget.
QUOTA_GLOBAL_DAY=3000
QUOTA_GLOBAL_MINUTE=300
